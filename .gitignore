tools/*.png
tools/meshy-state.json
tools/voicelines.json

# Loose verification screenshots at the repo root (public/assets media is kept)
/*.png
/*.jpg

# Local agent / tooling state
.claude/
.playwright-mcp/
tools/*.output

# Editor / OS
.DS_Store
*.log
